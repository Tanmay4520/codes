# Import libraries
import nltk

# Download required datasets
nltk.download('punkt')
nltk.download('wordnet')
nltk.download('omw-1.4')

# Import tokenizers
from nltk.tokenize import word_tokenize
from nltk.tokenize import TreebankWordTokenizer
from nltk.tokenize import TweetTokenizer
from nltk.tokenize import MWETokenizer

# Import stemmers
from nltk.stem import PorterStemmer
from nltk.stem import SnowballStemmer

# Import lemmatizer
from nltk.stem import WordNetLemmatizer

# Input text
text = "Hello! My name is Tanmay. I love Natural Language Processing and machine-learning."

print("Original Text:")
print(text)

# 1. Whitespace Tokenization
print("\n1. Whitespace Tokenization")
whitespace_tokens = text.split()
print(whitespace_tokens)

# 2. Punctuation-based Tokenization
print("\n2. Punctuation-based Tokenization")
punct_tokens = word_tokenize(text)
print(punct_tokens)

# 3. Treebank Tokenization
print("\n3. Treebank Tokenization")
treebank = TreebankWordTokenizer()
treebank_tokens = treebank.tokenize(text)
print(treebank_tokens)

# 4. Tweet Tokenization
print("\n4. Tweet Tokenization")
tweet = TweetTokenizer()
tweet_tokens = tweet.tokenize(text)
print(tweet_tokens)

# 5. MWE Tokenization
print("\n5. MWE Tokenization")
mwe = MWETokenizer([('Natural', 'Language'), ('machine-learning',)])
mwe_tokens = mwe.tokenize(text.split())
print(mwe_tokens)

# Stemming
words = ["running", "playing", "easily", "fairly"]

# Porter Stemmer
print("\n6. Porter Stemming")
porter = PorterStemmer()

for word in words:
    print(word, "->", porter.stem(word))

# Snowball Stemmer
print("\n7. Snowball Stemming")
snowball = SnowballStemmer("english")

for word in words:
    print(word, "->", snowball.stem(word))

# Lemmatization
print("\n8. Lemmatization")
lemmatizer = WordNetLemmatizer()

for word in words:
    print(word, "->", lemmatizer.lemmatize(word))
